{
  "type": "FeatureCollection",
  "name": "mit_wpu_roads",
  "metadata": {
    "title": "MIT-WPU poster-aligned campus road schematic",
    "description": "Road centerlines manually traced in image pixel space from the user-supplied campus layout poster and transformed with the provisional affine calibration below. Not a surveyed basemap.",
    "coordinate_reference_system": "OGC:CRS84",
    "coordinate_order": "longitude, latitude",
    "units": {
      "capacity": "vehicles per hour (illustrative)",
      "free_flow_time_sec": "seconds",
      "layout_coordinates": "poster pixels [x,y]"
    },
    "layout_image": "/static/assets/mit_wpu_campus_layout.png",
    "layout_calibration": {
      "width_px": 479,
      "height_px": 816,
      "west_lon": 73.8162,
      "east_lon": 73.81975,
      "south_lat": 18.5161,
      "north_lat": 18.52165,
      "status": "provisional; replace with surveyed control points for live GPS accuracy"
    },
    "network_model": "Directed edges; reverse movements are separate features. Main Gate, Gate 3, and Cast Gate are modeled as boundary nodes.",
    "flow_boundary_convention": "Positive values are entry supply, negative values are exit demand. Steady-state boundary values must sum to zero.",
    "topology_note": "e19/e20 represent an illustrative Gate 1 bypass trace for closure simulation; validate against the actual road centerline before operational use."
  },
